# ============================================
# MIMIC-IV / patient data — NEVER commit, ever
# Data Use Agreement prohibits redistribution
# ============================================
data/nodes/
data/splits/
data/raw/
data/*.csv
data/*.parquet
*.parquet
mimic*/
MIMIC*/

# Cached embeddings/model artifacts derived from real patient text/data
models/checkpoints/*.pt
models/checkpoints/*.pth
data/nodes/**/text_embeddings.npz
monitoring/logs/history.jsonl

# ============================================
# Secrets / credentials — never commit
# ============================================
.env
.env.*
*.pem
*.key
config/secrets.yaml
**/credentials.json

# ============================================
# Generated experiment output — regenerable, not source
# Keep results/registry.jsonl tracked (it IS the evidence trail)
# but ignore heavy raw/plot-cache artifacts
# ============================================
results/raw/
results/plots/*.png
results/plots/*.svg
wandb/
runs/
*.ckpt

# ============================================
# Python
# ============================================
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ============================================
# Docker / OS / editor noise
# ============================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# ============================================
# Explicitly NOT ignored (documented here for clarity, not functional)
